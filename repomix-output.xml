  container: {
    flex: 1,
    backgroundColor: COLORS.background,
  },
  scrollContent: {
    padding: SIZES.padding,
    paddingTop: 60,
    paddingBottom: 100,
  },
  headerTitle: {
    color: COLORS.text,
