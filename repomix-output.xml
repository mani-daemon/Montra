const { width } = Dimensions.get('window');

const CATEGORY_COLORS = {
  Food: '#F59E0B',
  Shopping: '#EC4899',
  Salary: '#10B981',
  Entertainment: '#8B5CF6',
  Transport: '#3B82F6',
  General: '#6B7280',
};

export default function AnalyticsScreen() {
  const [refreshing, setRefreshing] = useState(false);
  const [summary, setSummary] = useState({ balance: 0, total_income: 0, total_expense: 0 });
  const [pieData, setPieData] = useState([]);
  const [barData, setBarData] = useState([]);

  const fetchData = async () => {
    try {
      const summaryData = await getSummary();
      const transactions = await getTransactions();

      setSummary(summaryData);

      // ۱. آماده‌سازی داده‌ها برای نمودار میله‌ای (Income vs Expense)
      const barChartData = [
        {
          value: summaryData.total_income,
          label: 'Income',
          frontColor: '#10B981',
          topLabelComponent: () => (
            <Text style={{ color: '#10B981', fontSize: 11, fontWeight: 'bold', marginBottom: 4 }}>
              ${summaryData.total_income}
            </Text>
          ),
        },
        {
          value: summaryData.total_expense,
          label: 'Expense',
          frontColor: '#EF4444',
          topLabelComponent: () => (
            <Text style={{ color: '#EF4444', fontSize: 11, fontWeight: 'bold', marginBottom: 4 }}>
              ${summaryData.total_expense}
            </Text>
          ),
        },
      ];
      setBarData(barChartData);

      // ۲. آماده‌سازی داده‌ها برای نمودار دونات/دایره‌ای (Expense Categories)
      const expenses = transactions.filter((t) => t.type === 'expense');
      const totals = {};
      expenses.forEach((t) => {
        totals[t.category] = (totals[t.category] || 0) + t.amount;
      });

      const pieChartData = Object.keys(totals).map((cat) => ({
        value: totals[cat],
        color: CATEGORY_COLORS[cat] || '#6366F1',
        text: cat,
      }));

      setPieData(pieChartData);
    } catch (error) {
      console.error('Error fetching analytics:', error);
    }
  };

  useEffect(() => {
    fetchData();
  }, []);

  const onRefresh = async () => {
    setRefreshing(true);
    await fetchData();
    setRefreshing(false);
  };

  return (
    <View style={styles.container}>
      <ScrollView
        contentContainerStyle={styles.scrollContent}
        refreshControl={
          <RefreshControl refreshing={refreshing} onRefresh={onRefresh} tintColor="#6366F1" />
        }
      >
        {/* Header */}
        <Text style={styles.headerTitle}>Financial Analytics</Text>

        {/* Chart 1: Bar Chart (Income vs Expenses) */}
        <View style={styles.chartCard}>
          <Text style={styles.chartTitle}>Income vs Expense</Text>
          <View style={{ alignItems: 'center', marginTop: 10 }}>
            <BarChart
              data={barData}
              barWidth={45}
              initialSpacing={40}
              spacing={50}
              barBorderRadius={8}
              yAxisThickness={0}
              xAxisThickness={0}
              xAxisLabelTextStyle={{ color: '#A1A1AA', fontSize: 12, fontWeight: '600' }}
              noOfSections={3}
              maxValue={Math.max(summary.total_income, summary.total_expense, 100) * 1.2}
              isAnimated
            />
          </View>
        </View>

        {/* Chart 2: Donut/Pie Chart (Expense Breakdown) */}
        <View style={styles.chartCard}>
          <Text style={styles.chartTitle}>Expense Breakdown</Text>
          
          {pieData.length > 0 ? (
            <View style={{ alignItems: 'center', marginVertical: 15 }}>
              <PieChart
                data={pieData}
                donut
                showGradient
                sectionAutoFocus
                radius={90}
                innerRadius={60}
                innerCircleColor={'#18181B'}
                centerLabelComponent={() => {
                  return (
                    <View style={{ justifyContent: 'center', alignItems: 'center' }}>
                      <Text style={{ fontSize: 18, color: '#FFFFFF', fontWeight: 'bold' }}>
                        ${summary.total_expense.toFixed(0)}
                      </Text>
                      <Text style={{ fontSize: 11, color: '#A1A1AA' }}>Spent</Text>
                    </View>
                  );
                }}
              />

              {/* Legend / راهنمای رنگ‌ها */}
              <View style={styles.legendContainer}>
                {pieData.map((item) => (
                  <View key={item.text} style={styles.legendItem}>
                    <View style={[styles.colorDot, { backgroundColor: item.color }]} />
                    <Text style={styles.legendText}>{item.text}</Text>
                    <Text style={styles.legendValue}>${item.value.toFixed(2)}</Text>
                  </View>
                ))}
              </View>
            </View>
          ) : (
            <Text style={styles.emptyText}>No expense data available to build chart.</Text>
          )}
        </View>
      </ScrollView>
    </View>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: '#09090B',
  },
  scrollContent: {
    padding: 20,
    paddingTop: 60,
