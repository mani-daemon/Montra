      </TouchableOpacity>

      {/* Total Balance Card */}
      <View style={styles.balanceCard}>
        <Text style={styles.balanceLabel}>Total Balance</Text>
        <Text style={styles.balanceAmount}>{currency.symbol}{summary.balance.toFixed(2)}</Text>
        
        <View style={styles.balanceStats}>
